# GEMINI_API_KEY: clave para llamadas a la API de Gemini (opcional).
# Se copia a .env.local y se sustituye por la clave real.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: URL pública donde se sirve la aplicación.
# Se usa para enlaces internos, callbacks OAuth y endpoints de API.
APP_URL="MY_APP_URL"
